# Browser-safe configuration only. Copy to .env.local and fill in real values.
#
# For the local Supabase stack: run `pnpm supabase:start`, then
# `pnpm node scripts/local-supabase-env.mjs` (or read `pnpm supabase:status`)
# and copy the API URL and anon/publishable key below. That script also writes
# the two release flags, so a laptop build is not left to guess them.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key

# Release flags: which customer-facing flows a build offers.
#
# Both take exactly "true" or "false", and both fail CLOSED: anything else — absent,
# empty, "1", "TRUE" — means the flow is off. `vite build` refuses to compile a bundle
# while either one is unstated, because a silent default once compiled public signup and
# password recovery into the deployed site on its own.
#
#   VITE_PUBLIC_SIGNUP_ENABLED   "Create an account" on /auth
#   VITE_AUTH_EMAIL_ENABLED      password recovery and the confirmation-link resend, on
#                                /auth and in Settings
#
# A local stack confirms email with its own mail catcher, so it sets both to "true".
# What production deploys is decided by Cloudflare's project environment variables, not
# by this file.
VITE_PUBLIC_SIGNUP_ENABLED=false
VITE_AUTH_EMAIL_ENABLED=false

# Never put a service-role key, sb_secret_* value, database password, SMTP
# credential, or payment credential in a VITE_* variable: this file is compiled
# into the public browser bundle.
