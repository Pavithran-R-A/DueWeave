# Edge Function runtime configuration for `supabase/functions/delete-account`.
# Copy to supabase/functions/.env for `supabase functions serve` only. A real value in this file,
# or in any committed sibling, is a credential leak: the file's purpose is to record names.
#
# On a deployed function the first three are injected by the Supabase platform, so nothing is pasted
# anywhere; `supabase secrets set` is the only supported way to supply the fourth. Read them with
# `Deno.env.get` (see index.ts) — `import.meta.env` and `process.env` are not the Edge Runtime's
# secret mechanism and `VITE_*` is compiled into the browser bundle.

# Auto-injected at deploy; the project URL the function talks to.
SUPABASE_URL=<project-url-from-the-dashboard>

# Auto-injected at deploy; the publishable/anon key. Browser-safe by design, and NOT an erasure
# capability on its own — the RPC is revoked from anon.
SUPABASE_ANON_KEY=<anon-key>

# Auto-injected at deploy; the server-side secret key. Used for exactly one call
# (`auth.admin.deleteUser`) and never placed in a response, a log line, or client code.
SUPABASE_SERVICE_ROLE_KEY=<secret-key-never-commit-this>

# NOT auto-injected. Set it at deploy time:
#   supabase secrets set ALLOWED_APP_ORIGIN=https://<the app's exact origin>
# The endpoint answers nobody until it is set, and compares it exactly — no prefix, no port
# tolerance, no wildcard.
ALLOWED_APP_ORIGIN=<exact-app-origin>
