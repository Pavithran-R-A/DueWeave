# Edge Function runtime configuration for `supabase/functions/delete-account`.
# Copy to supabase/functions/.env for local `supabase functions serve` only. Never commit real
# credentials. Hosted Supabase injects the SUPABASE_* variables automatically; only
# ALLOWED_APP_ORIGIN is an operator-supplied production secret/config value.

SUPABASE_URL=<project-url-from-the-dashboard>

# Current hosted key model: JSON dictionaries keyed by key name (normally "default").
SUPABASE_PUBLISHABLE_KEYS={"default":"<publishable-key>"}
SUPABASE_SECRET_KEYS={"default":"<secret-key-never-commit-this>"}

# Compatibility fallback for older local CLI/runtime versions. The function prefers the current
# dictionaries above when they are present.
SUPABASE_ANON_KEY=<legacy-anon-key-local-fallback>
SUPABASE_SERVICE_ROLE_KEY=<legacy-service-role-key-local-fallback>

# NOT auto-injected. Set this on the hosted project to the deployed frontend's exact origin.
# No wildcard is accepted by the function's origin contract.
ALLOWED_APP_ORIGIN=<exact-app-origin>
